---
import { why, art } from "../data/content.js";
import Chars from "./Chars.astro";
import Obj from "./Obj.astro";
const words = why.title.split(" ");
const sansPart = words.slice(0, -2).join(" ");
const serifPart = words.slice(-2).join(" ");
---
<section class="why" id="por-que-eu" aria-labelledby="why-title">
  <div class="wrap">
    <div class="why__head">
      <h2 id="why-title" class="why__title" aria-label={why.title}>
        <span data-split><Chars text={sansPart} /></span>
        <span class="serif" data-follow>{serifPart}</span>
      </h2>
      <Obj src={art.estrela} class="why__estrela" data-sticker />
    </div>
    <ol class="why__list">
      {why.items.map((item) => (
        <li class="why__item">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
